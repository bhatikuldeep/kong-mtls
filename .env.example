# Copy to .env and set KONNECT_TOKEN. Never commit .env.
KONNECT_REGION=eu            # us, eu, au, me, in, sg: where your Konnect organization lives
GATEWAY_PORT=8443            # change if 8443 is taken on this host
BACKEND_PORT=9443            # Part 2 backend, reachable from this host; change if 9443 is taken
# KONNECT_TOKEN: a Konnect personal access token (kpat_...)
KONNECT_TOKEN=
# Filled in by `make up` from the control plane in Konnect
KONG_CLUSTER_CONTROL_PLANE=
KONG_CLUSTER_SERVER_NAME=
KONG_CLUSTER_TELEMETRY_ENDPOINT=
KONG_CLUSTER_TELEMETRY_SERVER_NAME=
